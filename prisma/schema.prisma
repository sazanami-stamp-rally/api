// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  display_name String?
  is_activated Boolean       @default(false)
  Checkin      Checkin[]
  Cooldown     Cooldown[]
  Acheivement  Achievement[]
}

model Booth {
  id           String       @id
  display_name String
  floor        Int
  category     String
  passcode     String
  flags        String[]     @default([])
  Checkpoint   Checkpoint[]
  Broadcast    Broadcast[]
}

model Broadcast {
  id         String   @id @default(cuid())
  title      String
  body       String
  created_at DateTime @default(now())
  booth_id   String
  type       String @default("common")
  booth      Booth    @relation(fields: [booth_id], references: [id])
}

model Checkpoint {
  id                String     @id @default(cuid())
  display_name      String
  floor             Int
  cooldown_duration Int
  category          String
  booth_id          String?
  booth             Booth?     @relation(fields: [booth_id], references: [id])
  Checkin           Checkin[]
  Cooldown          Cooldown[]
}

model Checkin {
  id            String     @id @default(cuid())
  user_id       String
  checkpoint_id String
  checkpoint    Checkpoint @relation(fields: [checkpoint_id], references: [id])
  user          User       @relation(fields: [user_id], references: [id])
  checkin_time  DateTime   @default(now())
}

model Cooldown {
  id            String     @id @default(cuid())
  user_id       String
  checkpoint_id String
  end_time      DateTime
  user          User       @relation(fields: [user_id], references: [id])
  checkpoint    Checkpoint @relation(fields: [checkpoint_id], references: [id])
}

model Achievement {
  id             String   @id @default(cuid())
  user_id        String
  achievement_id String
  earned_time    DateTime @default(now())
  progress       Int?     @default(0)
  user           User     @relation(fields: [user_id], references: [id])
}
